# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Local (Docker): docker compose up -d  ->  a string abaixo já funciona
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zeu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/zeu?schema=public"

# Neon (produção): copie as duas strings do painel do Neon.
# DATABASE_URL  -> "Pooled connection"  (termina em -pooler.neon.tech)
# DIRECT_URL    -> "Direct connection"  (sem -pooler), usada pelas migrations
# DATABASE_URL="postgresql://user:senha@ep-xxx-pooler.us-east-2.aws.neon.tech/zeu?sslmode=require"
# DIRECT_URL="postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/zeu?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js
# -----------------------------------------------------------------------------
# Gere com: npx auth secret     (ou: openssl rand -base64 32)
AUTH_SECRET=""

# Em produção defina a URL pública. Na Vercel isso é detectado sozinho.
AUTH_URL="http://localhost:3000"

# E-mails que viram ADMIN automaticamente no primeiro login (separados por vírgula).
# Estes e-mails sempre conseguem entrar, mesmo sem convite.
ADMIN_EMAILS="voce@exemplo.com"

# -----------------------------------------------------------------------------
# Login com Google (recomendado)
# -----------------------------------------------------------------------------
# Com estas duas preenchidas, aparece o botão "Entrar com Google" na tela de
# login e ninguém depende de e-mail para entrar. A lista de convidados continua
# valendo: só entra quem está em ADMIN_EMAILS ou foi convidado no app.
#
# Onde pegar: console.cloud.google.com -> APIs e Serviços -> Credenciais ->
# Criar credenciais -> ID do cliente OAuth -> Aplicativo da Web.
# URI de redirecionamento autorizado:
#   https://SEU-SITE.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (para desenvolvimento)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------------------------------------------
# Envio do magic link (SMTP)
# -----------------------------------------------------------------------------
# Se EMAIL_SERVER ficar vazio, o app NÃO envia e-mail: ele imprime o link de
# login no terminal. Isso é proposital para desenvolvimento local.
#
# Resend (recomendado): EMAIL_SERVER="smtp://resend:SUA_API_KEY@smtp.resend.com:587"
# Gmail (senha de app):  EMAIL_SERVER="smtp://voce@gmail.com:senha_de_app@smtp.gmail.com:587"
EMAIL_SERVER=""
EMAIL_FROM="Salu <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Busca de terrenos na internet
# -----------------------------------------------------------------------------
# Basta UMA das três chaves. Sem nenhuma, o app entra em modo demonstração e
# devolve anúncios fictícios (marcados como tal na tela).
#
# Serper   -> https://serper.dev            2.500 buscas grátis
# Brave    -> https://api-dashboard.search.brave.com   2.000 buscas/mês grátis
# Tavily   -> https://tavily.com            1.000 buscas/mês grátis
#
# Atenção ao filtro de portais: o plano gratuito do Serper recusa operadores de
# busca ("Query pattern not allowed for free accounts"), então com ele a busca
# roda aberta e os resultados fora dos portais vêm marcados na lista. O Tavily
# restringe domínios por parâmetro, sem operador — é o único que filtra portal
# de verdade na cota gratuita.
SERPER_API_KEY=""
BRAVE_API_KEY=""
TAVILY_API_KEY=""

# Force um provedor específico: serper | brave | tavily | demo | auto (padrão)
BUSCA_PROVEDOR="auto"

# Portais consultados, separados por vírgula. Deixe vazio para usar o padrão.
BUSCA_PORTAIS=""

# Quantos endereços geocodificar por busca (cada um é ~1 s por causa do
# limite do Nominatim). Padrão: 25.
BUSCA_MAX_GEOCODE="25"

# Quantos resultados pedir por consulta (10 a 100). Padrão: 20.
# Suba se estiver faltando anúncio individual: as páginas de listagem do
# portal ficam no topo do Google e os anúncios de lote aparecem mais fundo.
# Confira o consumo de créditos do seu plano antes de subir muito.
BUSCA_RESULTADOS_POR_CONSULTA="20"

# -----------------------------------------------------------------------------
# Geocodificação (Nominatim / OpenStreetMap)
# -----------------------------------------------------------------------------
# OBRIGATÓRIO na prática: o Nominatim responde 403 para quem não se identifica
# com um contato real. Sem isso, nenhum endereço é geocodificado e todas as
# zonas ficam "a verificar".
NOMINATIM_USER_AGENT="salu/1.0 (voce@exemplo.com)"

# -----------------------------------------------------------------------------
# Confirmação da zona (GeoSampa)
# -----------------------------------------------------------------------------
# Nada a configurar: por padrão o app consulta o WFS público da Prefeitura a
# cada coordenada e confirma a zona na hora. As variáveis abaixo só existem
# para o dia em que a Prefeitura mudar algo de lugar.
#
# "off" desliga a consulta (a zona passa a ficar sempre "a verificar").
GEOSAMPA_WFS=""
# Camada consultada. Padrão: geoportal:perimetro_zona_lei_18177_24
# (Perímetro de Zonas — Lei 18.177/24, a LPUOS vigente).
GEOSAMPA_WFS_CAMADA=""
# Endpoint do serviço. Padrão:
# https://wfs.geosampa.prefeitura.sp.gov.br/geoserver/geoportal/wfs
GEOSAMPA_WFS_URL=""

# -----------------------------------------------------------------------------
# Camada de zoneamento local (alternativa offline ao GeoSampa)
# -----------------------------------------------------------------------------
# Caminho local ou URL de um GeoJSON em EPSG:4326 com os polígonos de zona.
# Quando preenchido, TEM PRECEDÊNCIA sobre o GeoSampa — e congela na data em
# que o arquivo foi gerado. Ver README.
ZONEAMENTO_GEOJSON=""
# Nome da propriedade que guarda a sigla da zona. Vazio = detecta sozinho.
ZONEAMENTO_CAMPO=""
